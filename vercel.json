{
  "crons": [
    {
      "path": "/api/publish-scheduled",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/auth/verify",
      "destination": "/api/verify-magic-link"
    },
    {
      "source": "/((?!api/|assets/|images/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}